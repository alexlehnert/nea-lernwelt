{
  "rewrites": [
    {
      "source": "/mikroskop.html",
      "destination": "/bio-expedition.html"
    },
    {
      "source": "/skelett.html",
      "destination": "/bio-expedition.html"
    }
  ],
  "headers": [
    {
      "source": "/sync.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/hefte.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/lernwelt-app.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/lernwelt-app.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
